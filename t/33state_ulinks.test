INIT
UTF8 1
WANTSTATE

!Underline colour with semicolons
RESET
PUSH "\e[58;2;10;20;30m"
  ?pen underline_color = rgb(10,20,30)
PUSH "\e[58;5;4m"
  ?pen underline_color = idx(4)
PUSH "\e[59m"
  ?pen underline_color = rgb(240,240,240,is_default_fg)

!Underline colour with colons, as sent by neovim and kitty
PUSH "\e[58:2::1:2:3m"
  ?pen underline_color = rgb(1,2,3)
PUSH "\e[58:2:0:4:5:6m"
  ?pen underline_color = rgb(4,5,6)
PUSH "\e[58:5:9m"
  ?pen underline_color = idx(9)

!A colon-form underline colour does not swallow the codes after it
PUSH "\e[0;4:3;58:2::255:0:0;1m"
  ?pen underline = 3
  ?pen underline_color = rgb(255,0,0)
  ?pen bold = on

!SGR 0 resets the underline colour
PUSH "\e[0m"
  ?pen underline_color = rgb(240,240,240,is_default_fg)

!Hyperlink with a BEL terminator and parameters
RESET
PUSH "\e]8;foo=bar:id=xyz;http://b.example/\a"
  ?pen link = http://b.example/

!SGR reset leaves the hyperlink alone
RESET
PUSH "\e]8;;http://c.example/\e\\"
PUSH "\e[1;31m\e[0m"
  ?pen link = http://c.example/

!A full reset ends the hyperlink
PUSH "\ec"
  ?pen link = none

!Hyperlink split over several writes
RESET
PUSH "\e]8;;http://exa"
PUSH "mple.com/split"
PUSH "\e\\"
  ?pen link = http://example.com/split

!A hyperlink sequence without a separator is ignored
RESET
PUSH "\e]8;http://noseparator.example/\e\\"
  ?pen link = none
